{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "build/client",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/guides", "destination": "/articles", "permanent": true },
    { "source": "/guides/:id", "destination": "/articles/:id", "permanent": true }
  ]
}
